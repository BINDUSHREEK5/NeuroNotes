# Backend API base URL
VITE_API_URL=http://localhost:8000

# Supabase project URL and publishable (client-side) key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# RevenueCat Web Billing public API key
VITE_REVENUECAT_WEB_API_KEY=your_revenuecat_web_public_api_key_here

# Optional legacy client-key fallback used by the app
VITE_REVENUECAT_KEY=your_revenuecat_public_api_key_here
