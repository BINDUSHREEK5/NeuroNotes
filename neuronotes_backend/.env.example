# PostgreSQL/Supabase connection string
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database

# Supabase project URL used to validate access tokens
SUPABASE_URL=https://your-project.supabase.co

# Generate a unique, strong secret for local development
SECRET_KEY=replace_with_a_random_secret_at_least_64_characters

# AI providers
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Optional integration/configuration
REVENUECAT_WEBHOOK_AUTH=your_webhook_authorization_value
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:4173
